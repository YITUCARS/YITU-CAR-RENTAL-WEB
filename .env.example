# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Admin
ADMIN_PASSWORD=your-admin-password

# Vantu ticket distributor access for YITU admin.
# Must match the same value in the Vantu web project.
YITU_DISTRIBUTOR_SIGNING_SECRET=replace-with-a-long-random-shared-secret
VANTU_DISTRIBUTOR_TICKETS_URL=https://vantugroup.com/en/tickets

# RCM Car Rental API
RCM_API_KEY=your-rcm-api-key
RCM_AGENT_API_KEY=your-rcm-agent-api-key
RCM_AGENT_SHARED_SECRET=your-rcm-agent-shared-secret
RCM_AGENT_API_DOMAIN=api.rentalcarmanager.com
RCM_SHARED_SECRET=your-rcm-shared-secret
RCM_SANDBOX_URL=https://sandbox.rentalcarmanager.com
RCM_STRIPE_SUPPLIER_ID=1
RCM_REBILLING_SUPPLIER_ID=5
RCM_PHOTO_UPLOAD_METHOD=storeupload
RCM_DOCUMENT_LINK_SETUP_ID=your-rcm-document-link-setup-id
RCM_DOCUMENT_LINK_SETUP_IDS={"document-license-front":1,"pickup-front":2,"damage-1":3}
RCM_CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
RCM_CLOUDINARY_UPLOAD_PRESET=your-cloudinary-upload-preset

# Google
GOOGLE_PLACES_API_KEY=your-google-places-api-key

# OpenAI
# Used by TRI AI Car Finder beta to convert natural-language requests into structured RCM searches.
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4o-mini

# Viator affiliate API
VIATOR_API_KEY=your-viator-affiliate-api-key

# Firebase
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-firebase-app-id
FIREBASE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"

# Telegram notifications
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-group-chat-id
TELEGRAM_ALLOWED_CHAT_IDS=-1001234567890,123456789
TELEGRAM_NOTIFY_STATUS_CHANGES=false

# Cron + RCM Telegram sync
CRON_SECRET=your-vercel-cron-secret
RCM_WEBHOOK_SECRET=your-rcm-automation-webhook-secret
RCM_BOOKING_SYNC_DAYS_AHEAD=180
# RCM-confirmed method for the administrator's one-order Auto-Allocate test.
RCM_AUTO_ALLOCATE_METHOD=

# Local pricing transition: shadow compares local prices without changing the
# customer result; active makes the local master rates the displayed prices.
LOCAL_PRICING_MODE=shadow

# Stripe payments (final booking payment step)
# Server-side secret keys
STRIPE_TEST_SECRET_KEY=sk_test_key
STRIPE_LIVE_SECRET_KEY=sk_live_key
# Backward-compatible fallback for sandbox/test deployments.
STRIPE_SECRET_KEY=sk_test_key
# Client-side publishable keys (exposed to the browser)
NEXT_PUBLIC_STRIPE_MODE=live
NEXT_PUBLIC_STRIPE_TEST_PUBLISHABLE_KEY=pk_test_key
NEXT_PUBLIC_STRIPE_LIVE_PUBLISHABLE_KEY=pk_live_key
VANTU_STRIPE_TEST_SECRET_KEY=sk_test_vantu_key
VANTU_STRIPE_LIVE_SECRET_KEY=sk_live_vantu_key
# RCM payment supplier id mapped to the Stripe gateway (confirmpayment). Defaults to 5.
RCM_STRIPE_SUPPLIER_ID=5
# Comma-separated API keys for approved distribution partners.
PARTNER_API_KEYS=
