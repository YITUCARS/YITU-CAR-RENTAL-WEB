# ---------------------------------------------------------------------------
# market-intel environment
# ---------------------------------------------------------------------------

# Postgres. Point this at the same Supabase project the website uses
# (Supabase dashboard -> Project Settings -> Database -> Connection string ->
#  "Session pooler" / URI). The service writes into the `market_intel` schema
# only; it never touches the website's `public` tables.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Optional: a separate Postgres works too, e.g.
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/market_intel

# debug | info | warn | error
LOG_LEVEL=info
# pretty logs in a terminal, json in production
LOG_PRETTY=true

# Where failure screenshots / HTML snapshots are written
ARTIFACTS_DIR=./artifacts

# Global safety valve: never run more browser sessions than this across all sources
MAX_GLOBAL_CONCURRENCY=2

# Set to 1 to make every collector run against fixtures/mocks (no network)
DRY_RUN=0
